# Set these in Vercel → Project → Settings → Environment Variables.
# DATABASE_URL and BLOB_READ_WRITE_TOKEN are added for you when you connect
# a Neon database and a Blob store under the project's Storage tab.

DATABASE_URL=            # Neon Postgres connection string (auto)
BLOB_READ_WRITE_TOKEN=   # Vercel Blob (auto)
SETUP_CODE=              # any secret phrase; needed once to create the first admin
CRON_SECRET=             # optional; Vercel sends it to /api/cron/daily
ADMIN_API_TOKEN=         # optional; lets `npm run sync` push to the hosted app
LINK_RECHECK_DAYS=30     # optional
